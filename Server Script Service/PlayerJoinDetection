local Players = game:GetService("Players")

Players.PlayerAdded:Connect(function(player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = 0
	coins.Parent = leaderstats
	local doubleCoins = Instance.new("BoolValue")
	doubleCoins.Name = "2x Coins"
	doubleCoins.Value = false
	doubleCoins.Parent = leaderstats
	local sprintUpgrade = Instance.new("BoolValue")
	sprintUpgrade.Name = "Sprint Upgrade"
	sprintUpgrade.Value = false
	sprintUpgrade.Parent = leaderstats
end)