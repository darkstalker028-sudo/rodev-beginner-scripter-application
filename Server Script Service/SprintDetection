local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local SprintEventStart = ReplicatedStorage:WaitForChild("SprintReqStart")
local SprintEventStop = ReplicatedStorage:WaitForChild("SprintReqStop")

SprintEventStart.OnServerEvent:Connect(function(player)
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local sprint = leaderstats:FindFirstChild("Sprint Upgrade")
		if sprint and sprint.Value == true then
			local character = player.Character
			if character then
				local humanoid = character:FindFirstChild("Humanoid")
				if humanoid then
					humanoid.WalkSpeed = 25
				end
			end
		end
	end
end)

SprintEventStop.OnServerEvent:Connect(function(player)
	local character = player.Character
	if character then
		local humanoid = character:FindFirstChild("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = 16
		end
	end
end)